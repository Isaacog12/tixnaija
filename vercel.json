{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.tixnaija.name.ng" }],
      "destination": "https://tixnaija.name.ng/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com; connect-src 'self' wss: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; frame-src 'self' https://js.paystack.co;"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    }
  ],
  "env": {
    "VITE_SUPABASE_URL": "https://bjijftxksykbjknbleul.supabase.co",
    "VITE_SUPABASE_ANON_KEY": "sb_publishable_RfXOHwPhaVxfcVhVX-UzvA_2GoeqbfZ"
  }
}
