{
  "expo": {
    "name": "TixNaija",
    "slug": "tixnaija-mobile",
    "scheme": "tixnaija",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#22201e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.tixnaija.app"
    },
    "android": {
      "package": "ng.tixnaija.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#22201e"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TixNaija to use your camera to scan ticket QR codes at the gate."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TixNaija to access your photo library to select event cover flyers."
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "updates": {
      "url": "https://u.expo.dev/87928ff1-f32b-4a1b-8d41-ea77c28f71d0"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "87928ff1-f32b-4a1b-8d41-ea77c28f71d0"
      }
    }
  }
}
