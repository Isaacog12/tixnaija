# TixNaija environment template
# Copy to .env / .env.local and fill in. Never commit real values.
#
# Web client vars are exposed to the browser at build time (VITE_ prefix).
# Server-only secrets must stay out of any VITE_ / EXPO_PUBLIC_ variable.

# --- Web (build-time, client-visible) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server / SSR only ---
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=

# Service-role equivalent. Bypasses RLS: server-side only.
# Set in Vercel for the web server and via `supabase secrets set` for the
# edge functions. Code falls back to SUPABASE_SERVICE_ROLE_KEY while the
# legacy key is still in use.
APP_SECRET_KEY=
